{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://free-domain-name.org/schemas/client.schema.json",
  "title": "Free Domain Name client index",
  "description": "Generated from registry/names/**. Do not hand-edit client.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "layout",
    "recordCount",
    "wildcardCount",
    "updatedAt",
    "records"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "layout": {
      "const": "client-v1"
    },
    "name": {
      "type": "string",
      "maxLength": 120
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "recordCount": {
      "type": "integer",
      "minimum": 0
    },
    "wildcardCount": {
      "type": "integer",
      "minimum": 0
    },
    "records": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "$defs": {
    "hostname": {
      "type": "string",
      "pattern": "^(?:\\*\\.)?(?=.{1,253}$)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "plainHostname": {
      "type": "string",
      "pattern": "^(?=.{1,253}$)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "ipv4": {
      "type": "string",
      "pattern": "^(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])$"
    },
    "ipv6": {
      "type": "string",
      "pattern": "^(?:(?:[0-9A-Fa-f]{1,4}:){7}[0-9A-Fa-f]{1,4}|(?:[0-9A-Fa-f]{1,4}:){1,7}:|(?:[0-9A-Fa-f]{1,4}:){1,6}:[0-9A-Fa-f]{1,4}|(?:[0-9A-Fa-f]{1,4}:){1,5}(?::[0-9A-Fa-f]{1,4}){1,2}|(?:[0-9A-Fa-f]{1,4}:){1,4}(?::[0-9A-Fa-f]{1,4}){1,3}|(?:[0-9A-Fa-f]{1,4}:){1,3}(?::[0-9A-Fa-f]{1,4}){1,4}|(?:[0-9A-Fa-f]{1,4}:){1,2}(?::[0-9A-Fa-f]{1,4}){1,5}|[0-9A-Fa-f]{1,4}:(?:(?::[0-9A-Fa-f]{1,4}){1,6})|:(?:(?::[0-9A-Fa-f]{1,4}){1,7}|:))$"
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "owner"
      ],
      "anyOf": [
        {
          "required": [
            "url"
          ]
        },
        {
          "required": [
            "cname"
          ]
        },
        {
          "required": [
            "a"
          ]
        },
        {
          "required": [
            "aaaa"
          ]
        }
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/hostname"
        },
        "owner": {
          "type": "string",
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})$"
        },
        "description": {
          "type": "string",
          "maxLength": 280
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://",
          "maxLength": 2048
        },
        "cname": {
          "$ref": "#/$defs/plainHostname"
        },
        "a": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/ipv4"
          }
        },
        "aaaa": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/ipv6"
          }
        }
      }
    }
  }
}
